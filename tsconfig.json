{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "baseUrl": ".",
    "types": ["astro/client"]
  },
  "include": ["web/src/**/*", "bits/*/src/**/*", "templates/*/src/**/*"],
  "exclude": ["node_modules", "web/dist", "bits/*/dist"]
}
