---
/**
 * Minimal page chrome. It is NOT the future public site: it exists so every Bit can be
 * previewed and shared on its own. Bits never depend on it.
 */
import '../styles/base.css';
import type { BitManifest } from '../lib/catalog';

interface Props {
  title: string;
  bit?: BitManifest;
  standalone?: boolean;
}
const { title, bit, standalone = false } = Astro.props;
---
<!doctype html>
<html lang={bit?.language ?? 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}{standalone ? '' : ' · OrbBits'}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='11' fill='none' stroke='%231f5fbf' stroke-width='3'/%3E%3Ccircle cx='24' cy='9' r='4' fill='%23e0a100'/%3E%3C/svg%3E" />
    {bit?.description && <meta name="description" content={bit.description} />}
  </head>
  <body>
    <div class="orb-page">
      <header class="orb-header">
        <h1>{title}</h1>
        {bit && (
          <div class="orb-badges">
            <span class="orb-badge">{bit.kind}</span>
            <span class="orb-badge">{bit.role}</span>
            <span class="orb-badge">{bit.engine}</span>
            <span class="orb-badge" data-status={bit.status}>{bit.status}</span>
          </div>
        )}
        {!standalone && bit && <nav><a href="/">← all Bits</a></nav>}
      </header>
      {bit?.description && <p class="orb-description">{bit.description}</p>}
      <main>
        <slot />
      </main>
      <footer class="orb-footer">OrbBits{bit && <> · <code>{bit.id}</code></>}</footer>
    </div>
  </body>
</html>
