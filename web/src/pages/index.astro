---
/**
 * Home: the OrbBits library. Lists every published Bit (usable/curated) under a toolbar for
 * search, filters and sorting; the local dev server also shows drafts in a separate section.
 * Derived from bits/<id>/bit.yml.
 *
 * In export mode (`just export <id>`) the site root is the exported Bit instead.
 */
import Shell from '../layouts/Shell.astro';
import BitView from '../components/BitView.astro';
import BitCard from '../components/BitCard.astro';
import CatalogToolbar from '../components/CatalogToolbar.astro';
import { bits, exportBitId, getBit, isPublished, publishedBits, type BitManifest } from '../lib/catalog';
import { SITE } from '../lib/site';

const exported = exportBitId ? getBit(exportBitId) : undefined;
if (exportBitId && !exported) {
  throw new Error(`ORBBITS_EXPORT_BIT=${exportBitId} does not match any bits/*/bit.yml`);
}
// Server order = the toolbar's default sort (newest first, then by title), so nothing moves on load.
const newestFirst = (a: BitManifest, b: BitManifest) =>
  (b.created ?? '').localeCompare(a.created ?? '') || a.title.localeCompare(b.title, 'it');
const published = [...publishedBits].sort(newestFirst);
const drafts = import.meta.env.DEV ? bits.filter((b) => !isPublished(b)).sort(newestFirst) : [];
---
{exported ? (
  <Shell title={exported.title} bit={exported} standalone>
    <BitView bit={exported} />
  </Shell>
) : (
  <Shell title={SITE.name}>
    <p class="orb-description">{SITE.tagline}</p>

    {published.length + drafts.length > 1 && <CatalogToolbar bits={[...published, ...drafts]} />}

    <ul class="orb-catalog">
      {published.map((bit) => <BitCard bit={bit} />)}
    </ul>
    {publishedBits.length === 0 && <p class="orb-empty">Nessun Bit pubblicato.</p>}
    <p class="orb-empty orb-nomatch" hidden>{SITE.catalog.noMatch}</p>

    {drafts.length > 0 && (
      <section class="orb-drafts">
        <h2>{SITE.drafts}</h2>
        <ul class="orb-catalog">
          {drafts.map((bit) => <BitCard bit={bit} />)}
        </ul>
      </section>
    )}
  </Shell>
)}

