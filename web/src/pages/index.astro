---
import Shell from '../layouts/Shell.astro';
import BitView from '../components/BitView.astro';
import { bits, exportBitId, getBit } from '../lib/catalog';

// In export mode the site root IS the exported Bit; otherwise it is the local catalog.
const exported = exportBitId ? getBit(exportBitId) : undefined;
if (exportBitId && !exported) {
  throw new Error(`ORBBITS_EXPORT_BIT=${exportBitId} does not match any bits/*/bit.yml`);
}
---
{exported ? (
  <Shell title={exported.title} bit={exported} standalone>
    <BitView bit={exported} />
  </Shell>
) : (
  <Shell title="OrbBits">
    <p class="orb-description">Local catalog · {bits.length} Bit{bits.length === 1 ? '' : 's'}</p>
    <ul class="orb-catalog">
      {bits.map((bit) => (
        <li>
          <a href={`/bits/${bit.id}`}>{bit.title}</a>
          <span class="orb-badges">
            <span class="orb-badge">{bit.kind}</span>
            <span class="orb-badge">{bit.role}</span>
            <span class="orb-badge">{bit.engine}</span>
            <span class="orb-badge" data-status={bit.status}>{bit.status}</span>
          </span>
          <span class="orb-id">{bit.id}</span>
        </li>
      ))}
    </ul>
  </Shell>
)}
