---
/**
 * Renders the artifact of any Bit, by kind, in one language (the Bit's default locale
 * unless the page says otherwise):
 * - interactive: mounts bits/<id>/src/index.tsx through BitHost, passing the locale;
 * - video / figure / document: shows the declared classroom-ready outputs from dist/ for
 *   that language, followed by download links for every output (localised ones labelled),
 *   because the canonical page is the URL to share, never the raw file.
 */
import BitHost from '../lib/BitHost';
import { bitLocale, firstOutput, outputUrl, outputsFor, type BitManifest } from '../lib/catalog';
import { SITE } from '../lib/site';

interface Props {
  bit: BitManifest;
  locale?: string;
}
const { bit, locale = bitLocale(bit) } = Astro.props;

const shown = outputsFor(bit, locale);
const video = firstOutput(shown, 'mp4', 'webm');
const poster = firstOutput(shown, 'webp', 'png', 'jpg');
const image = firstOutput(shown, 'svg', 'png', 'webp', 'jpg');
const pdf = firstOutput(shown, 'pdf');

const url = (file?: string) => (file ? outputUrl(bit.id, file) : undefined);
const basename = (file: string) => file.replace(/^dist\//, '');
const links = (bit.outputs ?? [])
  .map((o) => ({ ...o, url: outputUrl(bit.id, o.file), name: basename(o.file) }))
  .filter((o) => o.url);
---
<div class="orb-bit" data-kind={bit.kind} data-bit={bit.id} lang={locale}>
  {bit.kind === 'interactive' && <BitHost id={bit.id} locale={locale} client:only="react" />}

  {bit.kind === 'video' && (url(video?.file)
    ? <video controls playsinline preload="metadata" src={url(video?.file)} poster={url(poster?.file)} />
    : <p class="orb-empty">{SITE.noOutput.video} — <code>just build {bit.id}</code></p>)}

  {bit.kind === 'figure' && (url(image?.file)
    ? <img src={url(image?.file)} alt={bit.title} />
    : <p class="orb-empty">{SITE.noOutput.figure} — <code>just build {bit.id}</code></p>)}

  {bit.kind === 'document' && (url(pdf?.file)
    ? <>
        <p class="orb-open"><a href={url(pdf?.file)} target="_blank" rel="noopener">{SITE.openPdf} ↗</a></p>
        <iframe src={url(pdf?.file)} title={bit.title} />
      </>
    : <p class="orb-empty">{SITE.noOutput.document} — <code>just build {bit.id}</code></p>)}

  {links.length > 0 && (
    <p class="orb-outputs">
      <span>{SITE.downloads}:</span>
      {links.map((o) => (
        <a href={o.url} download={o.name} title={o.description}>
          {o.name} <small>({o.locale ? `${o.format}, ${o.locale}` : o.format})</small>
        </a>
      ))}
    </p>
  )}
</div>
